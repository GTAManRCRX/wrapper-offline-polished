{
	"name": "Wrapper offline",
	"description": "GoAnimate server emulator",
	"version": "2.1.1",
	"homepage": "https://discord.gg/Kf7BzSw",
	"license": "MIT",
	"private": true,
	"scripts": {
		"postinstall": "node scripts/fixModules.js",
		"dev": "concurrently \"NODE_OPTIONS='--no-deprecation' node scripts/build.mjs --dev\" \"vite dev\"",
		"build": "vite build && node scripts/build.mjs",
		"package": "npx electron-packager dist --icon=dist/favicon.ico --overwrite"
	},
	"engines": {
		"node": ">=16"
	},
	"dependencies": {
		"@ffmpeg-installer/ffmpeg": "1.1.0",
		"@ffprobe-installer/ffprobe": "2.1.2",
		"@ts-ffmpeg/fluent-ffmpeg": "2.2.6",
		"@octanuary/httpz": "2.0.9",
		"fflate": "0.8.3",
		"formidable": "2.0.1",
		"modern-normalize": "3.0.1",
		"serve-handler": "6.1.7",
		"vue": "3.5.44",
		"vue-router": "5.0.7",
		"xmldoc": "3.0.0"
	},
	"devDependencies": {
		"@types/formidable": "3.5.1",
		"@types/node": "20.11.13",
		"@vitejs/plugin-vue": "6.0.10",
		"concurrently": "10.0.6",
		"electron": "11.5.0",
		"electron-packager": "17.1.2",
		"esbuild": "0.27.0",
		"vite": "6.4.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GTAManRCRX/wrapper-offline-tub.git"
	},
	"author": "GTAManRCR",
	"bugs": {
		"url": "https://github.com/GTAManRCRX/wrapper-offline-tub/issues"
	}
}
